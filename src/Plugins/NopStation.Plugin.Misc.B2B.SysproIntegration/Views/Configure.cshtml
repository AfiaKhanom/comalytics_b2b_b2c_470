@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

@await Component.InvokeAsync(typeof(StoreScopeConfigurationViewComponent))

<form asp-controller="SysproIntegration" asp-action="Configure" method="post">
    <nop-cards id="SysproIntegration-cards">
        <nop-card asp-name="SysproIntegration-general" asp-icon="fas fa-info" asp-title="@T("NopStation.Plugin.Misc.B2B.SysproIntegration.General")" asp-hide-block-attribute-name="@SysproIntegrationDefaults.HideGeneralBlock" asp-hide="@Model.HideGeneralBlock" asp-advanced="false">
            <div class="card-body">
                <div class="card card-default">
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="BaseUrl" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="BaseUrl" />
                                <span asp-validation-for="BaseUrl"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="Token" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="Token" />
                                <span asp-validation-for="Token"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="HttpCallMaxRetries" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="HttpCallMaxRetries" />
                                <span asp-validation-for="HttpCallMaxRetries"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="HttpCallRestTimeInSeconds" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="HttpCallRestTimeInSeconds" />
                                <span asp-validation-for="HttpCallRestTimeInSeconds"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-9 offset-md-3">
                                <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nop-card>
    </nop-cards>
</form>