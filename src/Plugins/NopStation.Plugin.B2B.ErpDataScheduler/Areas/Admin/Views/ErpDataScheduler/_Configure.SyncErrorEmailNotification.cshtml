@model ConfigurationModel

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
            <nop-override-store-checkbox asp-for="EnalbeSendingEmailNotificationOnSyncError_OverrideForStore" 
                asp-input="EnalbeSendingEmailNotificationOnSyncError" 
                asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
            <nop-label asp-for="EnalbeSendingEmailNotificationOnSyncError" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="EnalbeSendingEmailNotificationOnSyncError" />
            <span asp-validation-for="EnalbeSendingEmailNotificationOnSyncError"></span>
        </div>
    </div>
    <nop-nested-setting asp-for="EnalbeSendingEmailNotificationOnSyncError">
        <div class="form-group row" id="pnlEnalbeSendingEmailNotificationOnSyncError">
            <div class="col-md-3">
                <nop-override-store-checkbox asp-for="EmailAddresses_OverrideForStore" asp-input="EmailAddresses" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                <nop-label asp-for="EmailAddresses" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="EmailAddresses" />
                <span asp-validation-for="EmailAddresses"></span>
            </div>
        </div>
    </nop-nested-setting>
</div>

<script>
    $(document).ready(function () {
        $("#@Html.IdFor(model => model.EnalbeSendingEmailNotificationOnSyncError)")
            .click(toggleEnalbeSendingEmailNotificationOnSyncError);
        toggleEnalbeSendingEmailNotificationOnSyncError();
    });

    function toggleEnalbeSendingEmailNotificationOnSyncError() {
        if ($('#@Html.IdFor(model => model.EnalbeSendingEmailNotificationOnSyncError)').is(':checked')) {
            $('#pnlEnalbeSendingEmailNotificationOnSyncError').show();
        } else {
            $('#pnlEnalbeSendingEmailNotificationOnSyncError').hide();
        }
    }
</script>