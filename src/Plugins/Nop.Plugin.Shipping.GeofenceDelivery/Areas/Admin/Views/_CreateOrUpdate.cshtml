@model Nop.Plugin.Shipping.GeofenceDelivery.Areas.Admin.Models.GeofenceZoneModel
@{
    Layout = "_AdminLayout";
    var isNew = Model.Id == 0;
    ViewBag.PageTitle = isNew ? T("Plugins.Shipping.GeofenceDelivery.Zone.Add").Text : T("Plugins.Shipping.GeofenceDelivery.Zone.Edit").Text;
}

@using (Html.BeginForm(isNew ? "Create" : "Edit", "GeofenceDelivery", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    if (!isNew)
    {
        @Html.HiddenFor(m => m.Id)
    }
    <div class="content-header clearfix">
        <h1 class="float-left">@ViewBag.PageTitle</h1>
    </div>
    <div class="content">
        <div class="form-horizontal">
            <div class="panel-group">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title">@T("Plugins.Shipping.GeofenceDelivery.Zone.BasicInfo")</h3>
                    </div>
                    <div class="panel-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="Name" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="Name" />
                                <span asp-validation-for="Name"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="IsActive" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="IsActive" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="DisplayOrder" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="DisplayOrder" />
                                <span asp-validation-for="DisplayOrder"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="DeliveryFee" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="DeliveryFee" />
                                <span asp-validation-for="DeliveryFee"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="IsCollectionOnly" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="IsCollectionOnly" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title">@T("Plugins.Shipping.GeofenceDelivery.Zone.Boundaries")</h3>
                    </div>
                    <div class="panel-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="CoordinatesJson" />
                            </div>
                            <div class="col-md-9">
                                <textarea asp-for="CoordinatesJson" rows="5" class="form-control"></textarea>
                                <span asp-validation-for="CoordinatesJson"></span>
                                <small class="form-text text-muted">@T("Plugins.Shipping.GeofenceDelivery.Zone.CoordinatesJson.Hint")</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-9 offset-md-3">
                    <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                    <a asp-action="Configure" asp-controller="GeofenceDelivery" class="btn btn-default">@T("Admin.Common.Cancel")</a>
                </div>
            </div>
        </div>
    </div>
}
