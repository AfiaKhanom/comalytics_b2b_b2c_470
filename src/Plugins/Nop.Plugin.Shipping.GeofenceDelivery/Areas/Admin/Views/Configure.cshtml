@model ConfigurationModel

@{
    Layout = "_AdminLayout";
    ViewBag.Title = T("Plugins.Shipping.GeofenceDelivery.Configuration").Text;
    NopHtml.SetActiveMenuItemSystemName("Shipping.GeofenceDelivery");
}

@await Component.InvokeAsync(typeof(Nop.Web.Areas.Admin.Components.StoreScopeConfigurationViewComponent))

<form asp-controller="GeofenceDelivery" asp-action="Configure" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Shipping.GeofenceDelivery.Configuration")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                @await Html.PartialAsync("_CreateOrUpdate", Model)
            </div>
        </div>
    </section>
</form>

<div class="content">
    <div class="container-fluid">
        @await Html.PartialAsync("_ZoneList", Model.GeofenceZoneSearchModel)
    </div>
</div>
