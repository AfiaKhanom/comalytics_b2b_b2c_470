@model ErpOrderSettingsModel
@{
	Layout = "_AdminLayout";
	ViewBag.PageTitle = T("Plugins.NopStation.D365Integration.MappingOrder.Title").Text;
	NopHtml.SetActiveMenuItemSystemName("NopStation.Plugin.Misc.B2B.ODataIntegration.MappingOrder");

	Model.IsAdditionalHardCodedValuesNeeded = false;
	Model.IsSkipOnUpdatePropertyNeeded = true;
}

@{
	var customer = await workContext.GetCurrentCustomerAsync();
	const string hideSettingsBlockAttributeName = "MappingOrder.hideSettingsBlock";
	var hideSettingsBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideSettingsBlockAttributeName);

	const string hideOrderItemSettingsBlockAttributeName = "MappingOrder.hideOrderItemSettingsBlock";
	var hideOrderItemSettingsBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideOrderItemSettingsBlockAttributeName);

	const string hideShippingAddressSettingsBlockAttributeName = "MappingOrder.hideShippingAddressSettingsBlock";
	var hideShippingAddressSettingsBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideShippingAddressSettingsBlockAttributeName);

	const string hideBillingAddressSettingsBlockAttributeName = "MappingOrder.hideBillingAddressSettingsBlock";
	var hideBillingAddressSettingsBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideBillingAddressSettingsBlockAttributeName);

	const string hideRequestSettingsBlockAttributeName = "MappingOrder.hideRequestSettingsBlock";
	var hideRequestSettingsBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideRequestSettingsBlockAttributeName);
}

<form asp-controller="D365Integration" asp-action="MappingOrder" method="post">
	<div class="content-header clearfix">
		<h1 class="float-left">
			@T("Plugins.NopStation.D365Integration.MappingOrder.Title")
		</h1>
		<div class="float-right">
			<button type="submit" name="save" class="btn btn-primary">
				<i class="far fa-save"></i>
				@T("Admin.Common.Save")
			</button>
		</div>
	</div>

	<div asp-validation-summary="All"></div>

	<section class="content">
		<div class="container-fluid">
			<div class="form-horizontal">
				<nop-cards id="d365-integration-order-cards">
					<nop-card asp-name="d365-integration-order-settings"
							  asp-icon="fas fa-file-alt"
							  asp-title="@T("Plugins.NopStation.D365Integration.MappingOrder.Settings")"
							  asp-hide-block-attribute-name="@hideSettingsBlockAttributeName"
							  asp-hide="@hideSettingsBlock"
							  asp-advanced="false">
						@await Html.PartialAsync("_MappingOrder.D365IntegrationSettings", Model)
					</nop-card>
				</nop-cards>

				<nop-cards id="d365-integration-order-item-cards">
					<nop-card asp-name="d365-integration-order-Item-settings"
							  asp-icon="fas fa-file-alt"
							  asp-title="@T("Plugins.NopStation.D365Integration.MappingOrderItem.Settings")"
							  asp-hide-block-attribute-name="@hideOrderItemSettingsBlockAttributeName"
							  asp-hide="@hideOrderItemSettingsBlock"
							  asp-advanced="false">
						@await Html.PartialAsync("_MappingOrderItem.D365IntegrationSettings", Model)
					</nop-card>
				</nop-cards>

				<nop-cards id="d365-integration-shipping-address-cards">
					<nop-card asp-name="d365-integration-shipping-address-settings"
							  asp-icon="fas fa-file-alt"
							  asp-title="@T("Plugins.NopStation.D365Integration.MappingShippingAddress.Settings")"
							  asp-hide-block-attribute-name="@hideShippingAddressSettingsBlockAttributeName"
							  asp-hide="@hideShippingAddressSettingsBlock"
							  asp-advanced="false">
						@await Html.PartialAsync("_MappingShippingAddress.D365IntegrationSettings", Model)
					</nop-card>
				</nop-cards>

				<nop-cards id="d365-integration-billing-address-cards">
					<nop-card asp-name="d365-integration-billing-address-settings"
							  asp-icon="fas fa-file-alt"
							  asp-title="@T("Plugins.NopStation.D365Integration.MappingBillingAddress.Settings")"
							  asp-hide-block-attribute-name="@hideBillingAddressSettingsBlockAttributeName"
							  asp-hide="@hideBillingAddressSettingsBlock"
							  asp-advanced="false">
						@await Html.PartialAsync("_MappingBillingAddress.D365IntegrationSettings", Model)
					</nop-card>
				</nop-cards>

				<nop-cards id="d365-integration-request-cards">
					<nop-card asp-name="d365-integration-request-settings"
							  asp-icon="fas fa-info"
							  asp-title="@T("Plugins.NopStation.D365Integration.ErpGetRequestSettings.Settings")"
							  asp-hide-block-attribute-name="@hideRequestSettingsBlockAttributeName"
							  asp-hide="@hideRequestSettingsBlock"
							  asp-advanced="false">
						@await Html.PartialAsync("_MappingOrderRequest.D365IntegrationSettings", Model)
					</nop-card>
				</nop-cards>
			</div>
		</div>
	</section>
</form>
