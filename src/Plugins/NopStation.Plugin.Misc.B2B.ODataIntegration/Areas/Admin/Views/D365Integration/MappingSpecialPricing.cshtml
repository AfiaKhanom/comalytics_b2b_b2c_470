@model ErpPriceSpecialPricingDataSettingsModel
@{
	Layout = "_AdminLayout";
	ViewBag.PageTitle = T("Plugins.NopStation.D365Integration.MappingSpecialPricing.Title").Text;
	NopHtml.SetActiveMenuItemSystemName("NopStation.Plugin.Misc.B2B.ODataIntegration.MappingSpecialPrice");
}

@{
	var customer = await workContext.GetCurrentCustomerAsync();
	const string hideSettingsBlockAttributeName = "MappingSpecialPricing.hideSettingsBlock";
	var hideSettingsBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideSettingsBlockAttributeName);

	const string hideRequestSettingsBlockAttributeName = "MappingSpecialPricing.hideRequestSettingsBlock";
	var hideRequestSettingsBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideRequestSettingsBlockAttributeName);
}

<form asp-controller="D365Integration" asp-action="MappingSpecialPricing" method="post">
	<div class="content-header clearfix">
		<h1 class="float-left">
			@T("Plugins.NopStation.D365Integration.MappingSpecialPricing.Title")
		</h1>
		<div class="float-right">
			<button type="submit" name="save" class="btn btn-primary">
				<i class="far fa-save"></i>
				@T("Admin.Common.Save")
			</button>
		</div>
	</div>

	<div asp-validation-summary="All"></div>

	<section class="content">
		<div class="container-fluid">
			<div class="form-horizontal">
				<nop-cards id="d365-integration-cards">
					<nop-card asp-name="d365-integration-settings"
							  asp-icon="fas fa-tags"
							  asp-title="@T("Plugins.NopStation.D365Integration.MappingSpecialPricing.Settings")"
							  asp-hide-block-attribute-name="@hideSettingsBlockAttributeName"
							  asp-hide="@hideSettingsBlock"
							  asp-advanced="false">
						@await Html.PartialAsync("_MappingSpecialPricing.D365IntegrationSettings", Model)
					</nop-card>
				</nop-cards>

				<nop-cards id="d365-integration-request-cards">
					<nop-card asp-name="d365-integration-request-settings"
							  asp-icon="fas fa-info"
							  asp-title="@T("Plugins.NopStation.D365Integration.ErpGetRequestSettings.Settings")"
							  asp-hide-block-attribute-name="@hideRequestSettingsBlockAttributeName"
							  asp-hide="@hideRequestSettingsBlock"
							  asp-advanced="false">
						@await Html.PartialAsync("_MappingSpecialPriceRequest.D365IntegrationSettings", Model)
					</nop-card>
				</nop-cards>
			</div>
		</div>
	</section>
</form>
