@model ErpStockSettingModel

<div class="card-body">
	<div class="form-group row">
		<div class="col-md-3">
			<nop-label asp-for="ErpGetRequestSettingsModel.StockSyncLimit" />
		</div>
		<div class="col-md-9">
			<nop-editor asp-for="ErpGetRequestSettingsModel.StockSyncLimit" />
