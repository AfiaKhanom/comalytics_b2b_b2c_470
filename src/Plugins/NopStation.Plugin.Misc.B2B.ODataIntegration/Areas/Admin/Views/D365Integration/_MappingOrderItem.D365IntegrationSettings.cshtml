					<div class="input-group">
						<nop-select asp-for="ErpOrderItemDataSettingsModel.ExcludePropertySelectedValues" asp-items="Model.ErpOrderItemDataSettingsModel.AvailableProperties" asp-multiple="true" />
					</div>
				</div>
				<script>
					$(function() {
						var categoryIdsInput = $('#@Html.IdFor(model => model.ErpOrderItemDataSettingsModel.ExcludePropertySelectedValues)').select2({
							closeOnSelect: false,
					@if (!Model.AvailableProperties.Any())
					{
						<text>
								disabled: true,
								placeholder: "No properties available to select",
						</text>
					}
						});
					});
				</script>
			</div>
		</div>
	}
	
</div>

@if (Model.IsAdditionalHardCodedValuesNeeded)
{
	<script>
		$(document).ready(function () {
			const $textArea = $("#@Html.IdFor(model => model.ErpOrderItemDataSettingsModel.AdditionalHardCodedValues)");
			const placeholderText = `Add hard-coded values with key, value, and type in JSON format. Allowed types: string, int, bool, decimal, datetime. Example:
							[
								{ "key": "channel", "value": "web", "type": "string" },
								{ "key": "priority", "value": "1", "type": "int" },
								{ "key": "isTest", "value": "true", "type": "bool" },
								{ "key": "discount", "value": "10.5", "type": "decimal" },
								{ "key": "createdDate", "value": "2025-06-01", "type": "datetime" }
							]`;
			function togglePlaceholder() {
				if ($textArea.val().trim() === "") {
					$textArea
						.attr("placeholder", placeholderText)
						.addClass("with-placeholder");
				} else {
					$textArea
						.removeAttr("placeholder")
						.removeClass("with-placeholder");
				}
			}

			togglePlaceholder();
			$textArea.on("input change", togglePlaceholder);
		});
	</script>

	<style>
		.with-placeholder {
			min-height: 200px;
			font-style: italic;
			color: #6c757d;
		}
	</style>
}
