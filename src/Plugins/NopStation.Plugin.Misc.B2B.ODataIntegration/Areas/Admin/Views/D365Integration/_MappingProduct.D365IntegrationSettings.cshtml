<script>
	$(document).ready(function () {
		const $textArea = $("#@Html.IdFor(model => model.ProductAttributes)");
			const placeholderText = `Add product attribute with key and value in this format. The "Key" determines the attribute name and the "Value" determines the JSONPath selector. Example:

				[
				  { "Key": "Product_Attribute1", "Value": "$.value[*].PRODUCT_PORTFOLIO" },
				  { "Key": "Product_Attribute1", "Value": "$.value[*].SUB_BRAND" }
				]`;
		function togglePlaceholder() {
			if ($textArea.val().trim() === "") {
				$textArea
					.attr("placeholder", placeholderText)
					.addClass("with-placeholder");
			} else {
				$textArea
					.removeAttr("placeholder")
					.removeClass("with-placeholder");
			}
		}

		togglePlaceholder();
		$textArea.on("input change", togglePlaceholder);
	});
</script>

<style>
	.with-placeholder {
		min-height: 200px;
		font-style: italic;
		color: #6c757d;
	}
</style>

