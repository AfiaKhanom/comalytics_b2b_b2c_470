@model ErpCreateShipToAddressSettingsModel
@{
	Layout = "_AdminLayout";
	ViewBag.PageTitle = T("Plugins.NopStation.D365Integration.ErpCreateShipToAddressSettingsModel.Title").Text;
	NopHtml.SetActiveMenuItemSystemName("NopStation.Plugin.Misc.B2B.ODataIntegration.CreateShipToAddressMappings");
}

@{
	var customer = await workContext.GetCurrentCustomerAsync();
	const string hideSettingsBlockAttributeName = "MappingCreateShipToAddress.hideSettingsBlock";
	var hideSettingsBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideSettingsBlockAttributeName);
}

<form asp-controller="D365Integration" asp-action="MappingCreateShipToAddress" method="post">
	<div class="content-header clearfix">
		<h1 class="float-left">
			@T("Plugins.NopStation.D365Integration.ErpCreateShipToAddressSettingsModel.Title")
		</h1>
		<div class="float-right">
			<button type="submit" name="save" class="btn btn-primary">
				<i class="far fa-save"></i>
				@T("Admin.Common.Save")
			</button>
		</div>
	</div>

	<div asp-validation-summary="All"></div>

	<section class="content">
		<div class="container-fluid">
			<div class="form-horizontal">
				<nop-cards id="d365-integration-cards">
					<nop-card asp-name="d365-integration-settings"
							  asp-icon="fas fa-warehouse"
							  asp-title="@T("Plugins.NopStation.D365Integration.MappingCreateShipToAddress.Settings")"
							  asp-hide-block-attribute-name="@hideSettingsBlockAttributeName"
							  asp-hide="@hideSettingsBlock"
							  asp-advanced="false">
						@await Html.PartialAsync("_MappingCreateShipToAddress.D365IntegrationSettings", Model)
					</nop-card>
				</nop-cards>
			</div>
		</div>
	</section>
</form>

